# ===========================================
# CodeSentinel 环境变量模板
# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 排除）
# ===========================================

# --- LLM Provider ---
# 可选值：deepseek / anthropic / openai / ollama
LLM_PROVIDER=deepseek

# DeepSeek（推荐，OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic（备选）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI（备选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama 本地模型（Demo Day 兜底）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Agent 行为 ---
MAX_REVIEW_ROUNDS=2          # Reviewer/Verifier 最大循环次数
ENABLE_AUTO_FIX=true         # 是否自动生成修复 Patch
SEVERITY_THRESHOLD=medium    # low / medium / high

# --- 可观测性（可选） ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cs599-codesentinel
LANGSMITH_TRACING=false

LOG_LEVEL=INFO
LOG_FORMAT=json              # json / text
